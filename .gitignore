# the original downloads (72 MB); prep_models.py reads them, they are not part of the site
/*.glb
# per-group lighting atlases: already embedded in docs/models/museum.glb
build/bake_*.jpg
build/build.log

# kolkata_street: build logs, and renders/ which is build output.
# The few images the README shows live in kolkata_street/gallery/ and are kept.
/kolkata_street/build/*.log
/kolkata_street/renders/
# intermediate: the self-contained scene the web export reads
/kolkata_street/scene/_flat.blend*
# Blender's rolling backups
*.blend1
# kolkata_street: the deploy folder make_web.sh builds
/kolkata_street/dist/

# the 46 MB supplied tram source: too big to push by the web uploader and not
# needed to run the site. assets/tram_v3.blend is the street-scale asset built from it.
/kolkata_street/assets/tram_new/*.blend
